{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "testimonials (shared)",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "company": {
            "type": "string",
            "minLength": 1
          },
          "photo": {
            "type": "string",
            "pattern": "^images\\/.+\\.(jpe?g|png|webp|avif|svg)$"
          }
        },
        "required": [
          "id",
          "author",
          "company"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}

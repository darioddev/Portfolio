{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "projects (shared)",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "project",
              "architecture"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "repo_url": {
            "type": "string",
            "format": "uri"
          },
          "diagram": {
            "type": "string",
            "pattern": "^\\/[^\\s]+$"
          },
          "tech": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "date",
          "tech",
          "tags"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}

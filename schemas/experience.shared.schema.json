{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "experience (shared)",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "company": {
            "type": "string",
            "minLength": 1
          },
          "company_url": {
            "type": "string",
            "format": "uri"
          },
          "logo": {
            "type": "string",
            "pattern": "^images\\/.+\\.(jpe?g|png|webp|avif|svg)$"
          },
          "employment_type": {
            "type": "string",
            "enum": [
              "full_time",
              "part_time",
              "contract",
              "freelance",
              "internship"
            ]
          },
          "start_date": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?$"
          },
          "end_date": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?$"
          },
          "current": {
            "type": "boolean",
            "default": false
          },
          "tech_stack": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "id",
          "company",
          "company_url",
          "logo",
          "employment_type",
          "start_date",
          "tech_stack",
          "tags"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}

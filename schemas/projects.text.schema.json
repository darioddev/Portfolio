{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "projects (text)",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "diagram_alt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "summary",
          "highlights"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}

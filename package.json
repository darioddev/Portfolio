{
  "name": "api-integration-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal portfolio built with Astro. Content lives in YAML, UI strings in .properties files.",
  "engines": { "node": ">=20.3.0" },
  "scripts": {
    "dev": "npm run generate && astro dev",
    "start": "npm run dev",
    "generate": "tsx scripts/generate.ts",
    "validate": "npm run generate && tsx scripts/validate.ts",
    "prebuild": "npm run validate",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^5.14.0",
    "tailwindcss": "^4.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.20.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "eslint": "^9.20.0",
    "eslint-plugin-astro": "^1.3.1",
    "js-yaml": "^4.1.0",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0"
  }
}

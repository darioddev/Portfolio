---
import { t, type LocaleCode } from '@/i18n';
import type { Portfolio } from '@/utils/content';
import Section from './Section.astro';

interface Props {
  locale: LocaleCode;
  profile: Portfolio['profile'];
}
const { locale, profile } = Astro.props;
---

<Section id="contact" title={t(locale, 'section.contact.title')} intro={t(locale, 'section.contact.intro')}>
  <p class="font-mono text-xs tracking-widest text-soft uppercase">{t(locale, 'contact.email')}</p>
  <a href={`mailto:${profile.email}`} class="link font-display text-3xl break-all sm:text-4xl">{profile.email}</a>
  <p class="mt-10 font-mono text-xs tracking-widest text-soft uppercase">{t(locale, 'contact.elsewhere')}</p>
  <ul class="mt-3 flex flex-wrap gap-3" role="list">
    {
      profile.links.map((link) => (
        <li>
          <a class="btn btn-ghost" href={link.url} target="_blank" rel="me noopener noreferrer">
            {link.label}<span class="sr-only"> {t(locale, 'a11y.externalLink')}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>

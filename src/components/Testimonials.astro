---
import { Image } from 'astro:assets';
import { t, type LocaleCode } from '@/i18n';
import type { Portfolio } from '@/utils/content';
import { resolveImage } from '@/utils/images';
import Section from './Section.astro';

interface Props {
  locale: LocaleCode;
  items: Portfolio['testimonials'];
}
const { locale, items } = Astro.props;
---

<Section id="testimonials" title={t(locale, 'section.testimonials.title')} intro={t(locale, 'section.testimonials.intro')}>
  <ul class="grid gap-6 md:grid-cols-2" role="list">
    {
      items.map((item) => (
        <li>
          <figure class="card h-full p-6">
            <blockquote class="font-display text-xl leading-snug">{item.quote}</blockquote>
            <figcaption class="mt-4 flex items-center gap-3 text-sm">
              {item.photo && <Image src={resolveImage(item.photo)} alt="" width={40} height={40} class="h-10 w-10 rounded-full object-cover" />}
              <span><strong>{item.author}</strong><br /><span class="text-soft">{item.role} · {item.company}</span></span>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</Section>

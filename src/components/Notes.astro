---
import { t, type LocaleCode } from '@/i18n';
import type { Portfolio } from '@/utils/content';
import { formatDate } from '@/utils/dates';
import Section from './Section.astro';

interface Props {
  locale: LocaleCode;
  items: Portfolio['notes'];
  tagLabel: Portfolio['tagLabel'];
}
const { locale, items, tagLabel } = Astro.props;
---

<Section id="notes" title={t(locale, 'section.notes.title')} intro={t(locale, 'section.notes.intro')}>
  <ul class="divide-y divide-line" role="list">
    {
      items.map((note) => (
        <li class="py-5 first:pt-0">
          <p class="font-mono text-xs text-soft"><time datetime={note.date}>{formatDate(locale, note.date)}</time> · {note.tags.map((id) => `#${tagLabel(id)}`).join(' ')}</p>
          <h3 class="mt-1 text-xl">{note.title}</h3>
          <p class="mt-1 text-soft">{note.summary}</p>
          <a class="link text-sm font-semibold" href={note.url} target="_blank" rel="noopener noreferrer">{t(locale, 'notes.read')}<span class="sr-only"> {t(locale, 'a11y.externalLink')}</span></a>
        </li>
      ))
    }
  </ul>
</Section>

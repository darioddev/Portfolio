---
interface Props {
  id: string;
  title: string;
  intro?: string;
}
const { id, title, intro } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="scroll-mt-20 border-t border-line py-14 lg:py-20">
  <div class="wrap grid gap-8 lg:grid-cols-12 lg:gap-12">
    <header class="lg:col-span-4">
      <div class="lg:sticky lg:top-28">
        <span class="num" aria-hidden="true"></span>
        <h2 id={`${id}-title`} class="mt-2 text-3xl sm:text-4xl">{title}</h2>
        {intro && <p class="mt-3 max-w-prose text-soft">{intro}</p>}
      </div>
    </header>
    <div class="lg:col-span-8"><slot /></div>
  </div>
</section>

<style>
  .num {
    counter-increment: sec;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
  }
  .num::before {
    content: counter(sec, decimal-leading-zero) ' /';
  }
</style>

---
import { t, type LocaleCode } from '@/i18n';
import type { projectKinds } from '@/schemas';
import type { Portfolio } from '@/utils/content';
import { formatDate } from '@/utils/dates';
import Section from './Section.astro';

interface Props {
  locale: LocaleCode;
  kind: (typeof projectKinds)[number];
  items: Portfolio['projects'];
}
const { locale, kind, items } = Astro.props;
const id = kind === 'project' ? 'projects' : 'architecture';
const title = t(locale, kind === 'project' ? 'section.projects.title' : 'section.architecture.title');
const intro = t(locale, kind === 'project' ? 'section.projects.intro' : 'section.architecture.intro');
const entries = items.filter((item) => item.kind === kind);
---

<Section id={id} title={title} intro={intro}>
  <ul class="grid gap-6" role="list">
    {
      entries.map((item) => (
        <li class="card overflow-hidden">
          {item.diagram && (
            <img src={item.diagram} alt={item.diagram_alt ?? ''} width="960" height="540" loading="lazy" decoding="async" class="aspect-video w-full border-b-2 border-line object-contain" />
          )}
          <div class="p-5">
            <h3 class="text-xl">{item.title}</h3>
            <p class="text-sm text-soft"><time datetime={item.date}>{formatDate(locale, item.date)}</time></p>
            <p class="mt-3">{item.summary}</p>
            {item.highlights.length > 0 && (
              <ul class="mt-3 list-disc pl-5" aria-label={t(locale, 'projects.highlights')}>
                {item.highlights.map((text) => <li>{text}</li>)}
              </ul>
            )}
            <ul class="mt-4 flex flex-wrap gap-2" role="list" aria-label={t(locale, 'projects.tech')}>
              {item.tech.map((tech) => <li class="chip chip-mono">{tech}</li>)}
            </ul>
            <p class="mt-4 flex gap-5 text-sm font-semibold">
              {item.url && <a class="link" href={item.url} target="_blank" rel="noopener noreferrer">{t(locale, 'projects.visit')}<span class="sr-only"> {t(locale, 'a11y.externalLink')}</span></a>}
              {item.repo_url && <a class="link" href={item.repo_url} target="_blank" rel="noopener noreferrer">{t(locale, 'projects.source')}<span class="sr-only"> {t(locale, 'a11y.externalLink')}</span></a>}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>

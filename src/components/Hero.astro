---
import { Image } from 'astro:assets';
import { t, type LocaleCode } from '@/i18n';
import type { Portfolio } from '@/utils/content';
import { resolveImage } from '@/utils/images';

interface Props {
  locale: LocaleCode;
  profile: Portfolio['profile'];
  tagLabel: Portfolio['tagLabel'];
  fullUrl: Portfolio['fullUrl'];
  contactId?: string | undefined;
}
const { locale, profile, tagLabel, fullUrl, contactId } = Astro.props;
const photo = resolveImage(profile.photo);
const status = { open: 'var(--accent)', limited: 'var(--warn)', closed: 'var(--soft)' }[profile.availability];
---

<section id="about" aria-labelledby="about-title" class="scroll-mt-20">
  <div class="wrap grid gap-12 pt-12 pb-16 lg:grid-cols-12 lg:items-center lg:gap-16 lg:pt-20 lg:pb-24">
    <div class="lg:col-span-7">
      {profile.availability_text?.trim() && (
        <p class="avail text-sm text-soft">
          <span class="dot" style={`background:${status}`} aria-hidden="true"></span>
          {profile.availability_text}
        </p>
      )}
      <h1 id="about-title" class="mt-5 text-5xl sm:text-6xl">
        <span class="sr-only">{t(locale, 'section.about.title')}: </span>
        {profile.first_name} {profile.last_name}
      </h1>
      <p class="mt-4 max-w-xl text-xl font-medium text-accent sm:text-2xl">{profile.headline}</p>
      <p class="mt-5 max-w-xl text-lg">{profile.summary}</p>
      <div class="mt-4 max-w-xl space-y-3 text-soft">
        {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <ul class="mt-6 flex flex-wrap gap-2" role="list">
        {profile.tags.map((id) => <li class="chip chip-mono">#{tagLabel(id)}</li>)}
      </ul>
      <div class="mt-8 flex flex-wrap gap-3">
        {
          contactId && (
            <a class="btn" href={`#${contactId}`}>
              {profile.cta_label}
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
          )
        }
        <a class="btn btn-ghost" href={fullUrl(profile.cv)} download>
          {t(locale, 'cv.download')}
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"></path></svg>
        </a>
      </div>
    </div>

    <!-- The photo is desktop only: on phones the section stays a clean text column. -->
    <figure class="frame hidden lg:col-span-5 lg:block">
      <Image
        src={photo}
        alt={profile.photo_alt}
        width={640}
        widths={[320, 480, 640]}
        sizes="26rem"
        loading="lazy"
        decoding="async"
        class="photo"
      />
      <figcaption class="mt-3 font-mono text-xs text-soft">{profile.location}</figcaption>
    </figure>
  </div>
</section>

<style>
  .avail {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .dot {
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
  }
  .frame {
    position: relative;
    isolation: isolate;
    max-width: 26rem;
    margin-inline-start: auto;
  }
  /* An offset outline behind the photo, like a print slightly out of register. */
  .frame::before {
    content: '';
    position: absolute;
    inset: 0.9rem -0.9rem -0.9rem 0.9rem;
    z-index: -1;
    border: 1px solid var(--accent);
    border-radius: 8px;
  }
  .photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 8px;
    background: var(--line);
  }
</style>

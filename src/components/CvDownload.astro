---
import { t, type LocaleCode } from '@/i18n';
interface Props {
  locale: LocaleCode;
  href: string;
}
const { locale, href } = Astro.props;
---

<aside aria-labelledby="cv-callout" class="wrap pb-16 lg:pb-24">
  <div class="card callout">
    <div>
      <h2 id="cv-callout" class="text-2xl">{t(locale, 'cv.callout')}</h2>
      <p class="mt-1 max-w-md text-soft">{t(locale, 'cv.calloutText')}</p>
    </div>
    <a class="btn" href={href} download>
      {t(locale, 'cv.download')}
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"></path></svg>
    </a>
  </div>
</aside>

<style>
  .callout {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.75rem;
  }
</style>
